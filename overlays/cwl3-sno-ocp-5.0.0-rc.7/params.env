# One overlay = one oc-mirror run. All values are plain strings.
# RUN_NAME: names the Policy, CGU, PlacementBinding, Job, PVC and ISC ConfigMap.
#           DNS label, lowercase, <= 40 chars ("ztp-oc-mirror." + RUN_NAME must stay <= 63).
RUN_NAME=oc-mirror-5-0-0-rc7
# Hub namespace where the ISC ConfigMap, SA, PVC and Job are created (spoke/test namespace).
NAMESPACE=sno
# Existing pull secret in NAMESPACE with auths for the sources and the destination registry.
AUTH_SECRET=disconnected-quay-registry-pull-secret
# oc-mirror image: "oc-mirror" component of the OCP 4.22.3 release payload (oc-mirror v2 4.22.0).
OC_MIRROR_IMAGE=quay.io/openshift-release-dev/ocp-v4.0-art-dev@sha256:060fb60e8ea46552bc00b49d30518b701f63ecfeb88fdf95666a84f529da1de4
# prepare/report stages (oc + coreutils): "cli" component of the same OCP 4.22.3 payload.
CLI_IMAGE=quay.io/openshift-release-dev/ocp-v4.0-art-dev@sha256:3512edd3be82b233f4953be34dae13ce141ba9b1c71e5b60725afce78a2a6799
# Destination: docker://MIRROR_REGISTRY/MIRROR_PREFIX
MIRROR_REGISTRY=quayregistry
MIRROR_PREFIX=quayadmin/ocp5-candidate
# true: the prepare stage trusts the cluster ingress CA (openshift-config-managed/default-ingress-cert)
DEST_TLS_VERIFY=true
PVC_SIZE=5Gi
# Used only by demo/demo.sh and verify.sh (proof step), not rendered into any object.
VERIFY_RELEASE=5.0.0-rc.7
VERIFY_CHANNEL=candidate-5.0
